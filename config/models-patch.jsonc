{
  // ==============================================================================
  // OmniRoute Local Model Metadata Patches (JSONC)
  //
  // Use this file to complete and patch model metadata that upstream providers
  // (such as NVIDIA NIM, vLLM, Ollama, self-hosted gateways, etc.) fail to return.
  //
  // OmniRoute automatically monitors this file. Any changes saved here take effect
  // immediately without restarting OmniRoute.
  //
  // Supported fields for each model:
  // - "name": Human-readable display name.
  // - "context_length": Maximum input context tokens (e.g. 131072 for 128k).
  // - "max_output_tokens": Maximum generation output tokens (e.g. 4096, 16384).
  // - "supported_parameters": Array of supported parameter names, e.g.:
  //     ["temperature", "top_p", "max_tokens", "stream", "tools", "tool_choice", "response_format", "thinking"]
  // - "capabilities": Object with boolean flags:
  //     - "vision": true if model accepts images
  //     - "reasoning" / "thinking": true if model performs reasoning/thinking
  //     - "tool_calling": true if model supports function calling
  //     - "structured_output": true if model supports JSON schema / response_format
  //     - "effort_tiers": array of reasoning effort tiers, e.g. ["low", "medium", "high"]
  // - "input_modalities": ["text"], or ["text", "image"], etc.
  // - "output_modalities": ["text"]
  // - "type": "chat" | "embedding" | "image" | "rerank"
  // ==============================================================================
  "patches": {
    "nvidia": {
      // Default parameters supported by all NVIDIA NIM OpenAI-compatible models
      "*": {
        "supported_parameters": ["temperature", "top_p", "max_tokens", "stream"],
      },

      // ─── DeepSeek Reasoning & Chat Models ─────────────────────────────
      "deepseek-ai/deepseek-r1": {
        "name": "DeepSeek R1",
        "context_length": 131072,
        "max_output_tokens": 16384,
        "supported_parameters": ["temperature", "top_p", "max_tokens", "stream", "thinking"],
        "capabilities": {
          "vision": false,
          "reasoning": true,
          "thinking": true,
          "supportsThinking": true,
          "tool_calling": false,
          "structured_output": false,
        },
        "input_modalities": ["text"],
        "output_modalities": ["text"],
      },
      "deepseek-ai/deepseek-v3": {
        "name": "DeepSeek V3",
        "context_length": 131072,
        "max_output_tokens": 8192,
        "supported_parameters": [
          "temperature",
          "top_p",
          "max_tokens",
          "stream",
          "tools",
          "tool_choice",
          "response_format",
        ],
        "capabilities": {
          "vision": false,
          "reasoning": false,
          "tool_calling": true,
          "structured_output": true,
        },
        "input_modalities": ["text"],
        "output_modalities": ["text"],
      },

      // ─── Meta Llama 3.3 & 3.1 Series ──────────────────────────────────
